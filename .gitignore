*.db-shm
.env
.coverage
coverage.xml

# scripts/bake_vat.mjs — офлайн-бейкер VAT для крауд-игр, dev-only Node-тулинг.
# npm install тянет three.js локально; в репозиторий едут только .bin/.json,
# которые он производит под assets/game/, не сама node_modules.
scripts/node_modules/

# Рабочие каталоги Claude Code: worktree-копии репозитория, заведённые для
# параллельных агентов. Это не часть проекта и в историю попадать не должно.
# Скиллы — исключение: они переиспользуются между сессиями и должны жить в репо.
# (Родительскую .claude/ саму игнорировать нельзя — иначе git не спустится
# внутрь неё, чтобы применить исключение для skills/.)
.claude/*
!.claude/skills/

# Черновики видео-демонстраций (scripts/gen_exercise_demos.py): на принятый
# клип приходится несколько отбракованных дублей плюс сырое видео до сборки
# петли. В репозиторий едет только готовый media/exercises/<slug>_demo.mp4.
media/exercises/_demo_work/
